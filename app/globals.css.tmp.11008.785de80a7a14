@import "tailwindcss";

:root {
  /* Brand colors */
  --color-primary: #14B8A6;
  --color-secondary: #0EA5E9;

  /* Text colors */
  --color-text-primary: #1A1A1A;
  --color-text-muted: #6B7280;

  /* UI colors */
  --color-border: #E5E7EB;
  --color-nav-bg: rgba(255, 255, 255, 0.95);

  /* Gradients */
  --gradient-brand: linear-gradient(to right, #14B8A6, #0EA5E9);
  --gradient-brand-diagonal: linear-gradient(135deg, #14B8A6, #0EA5E9);

  /* Layout */
  --navbar-height: 80px;
  --container-max-width: 80rem;

  /* Effects */
  --navbar-blur: blur(12px);

  /* Typography */
  --font-size-nav: 0.875rem;
  --font-size-brand: 1.5rem;
  --font-weight-medium: 500;
  --font-weight-bold: 700;
  --letter-spacing-wide: 0.025em;
  --letter-spacing-tight: -0.025em;

  /* Icons */
  --icon-size-sm: 16px;
  --icon-size-md: 24px;
  --icon-size-lg: 28px;

  /* Buttons */
  --btn-px-sm: 1.5rem;
  --btn-py-sm: 0.625rem;
  --btn-px-md: 2rem;
  --btn-py-md: 1rem;
  --btn-icon-gap: 0.5rem;
  --btn-icon-size: 20px;
  --color-btn-glass-bg: rgba(255, 255, 255, 0.1);
  --color-btn-glass-border: rgba(255, 255, 255, 0.3);
  --color-btn-glass-hover: rgba(255, 255, 255, 0.2);

  /* Logo */
  --logo-circle-size: 40px;
  --logo-dot-size: 24px;

  /* Sections */
  --section-py: 6rem;
  --section-px: 1.5rem;
  --section-px-lg: 2rem;
  --color-section-bg-white: #FFFFFF;
  --color-section-bg-off-white: #FAFAFA;

  /* Badge */
  --color-badge-bg: linear-gradient(to right, #F0FDFA, #F0F9FF);
  --badge-px: 1rem;
  --badge-py: 0.25rem;
  --badge-font-size: 0.75rem;
  --badge-letter-spacing: 0.1em;

  /* Section headings */
  --font-size-section-heading-xs: 2.25rem;
  --font-size-section-heading-sm: 3rem;

  /* About */
  --about-grid-gap: 4rem;
  --about-stat-icon-size: 2rem;
  --about-stat-value-size: 1.5rem;
  --about-stat-label-size: 0.75rem;
  --about-stat-gap: 1.5rem;
  --about-deco-size: 8rem;
  --about-deco-offset: -1.5rem;

  /* Hero */
  --hero-overlay: linear-gradient(to bottom right, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.7));
  --color-hero-subtitle: rgb(209, 213, 219);
  --color-scroll-indicator: rgba(255, 255, 255, 0.6);
  --font-size-hero-xs: 3rem;
  --font-size-hero-md: 4.5rem;
  --font-size-hero-lg: 6rem;
  --font-size-subtitle-xs: 1.25rem;
  --font-size-subtitle-md: 1.5rem;
  --hero-content-max-width: 64rem;
  --hero-content-px: 1.5rem;
  --hero-heading-mb: 1.5rem;
  --hero-subtitle-mb: 3rem;
  --hero-subtitle-max-width: 48rem;
  --hero-btn-gap: 1rem;
  --hero-scroll-bottom: 3rem;
  --hero-scroll-icon-size: 2rem;
}

@keyframes hero-fade-in {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: none; }
}

@keyframes hero-scroll-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10px); }
}

body {
  background: var(--background);
  color: var(--color-text-primary);
  font-family: Arial, Helvetica, sans-serif;
}

/* Button size classes — bypasses MUI sx padding limitations with CSS variables */
.btn-sm {
  padding: var(--btn-py-sm) var(--btn-px-sm);
  font-size: var(--font-size-nav);
}

.btn-md {
  padding: var(--btn-py-md) var(--btn-px-md);
}
